{
  "manifest_version": 3,
  "name": "人生日历 Life Calendar",
  "version": "0.5.0",
  "description": "把一生画成一张表：看看已经走过的，和还剩下的日子。",
  "author": "AlbertSun",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
